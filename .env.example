# Copia como .env para desarrollo local. NUNCA subir a git ni pegar valores en chats.
# cp .env.example .env

# Puerto local (Render lo inyecta solo)
PORT=3100

# DRY_RUN=true evita llamadas reales a Graph API (útil para probar sin tokens)
DRY_RUN=false

# Base de datos Neon PostgreSQL (opcional; sin esto usa data.json local)
DATABASE_URL=

# --- Fuentes ---
# Token de usuario de larga duración de Facebook (Graph API Explorer).
# Permisos: user_posts, user_photos (+ instagram_basic para Instagram).
FACEBOOK_USER_TOKEN=

# ID numérico de la cuenta de Instagram (solo si es empresa/creador vinculada a una página de Facebook)
INSTAGRAM_USER_ID=

# --- IA (opcional; sin esto usa heurísticas locales sin costo) ---
# Con esta key también se activan la búsqueda semántica y el Q&A (v1.5.0):
# cada paquete se vectoriza al guardarse y /api/search + /api/qa funcionan.
# Sin ella, esas rutas responden 503 y nada más cambia.
# (Puedes copiar el valor de OPENAI_API_KEY del servicio asistente-puente en Render.)
OPENAI_API_KEY=

# --- v1.5.0: búsqueda semántica + Q&A (opcional) ---
# Modelos (defaults: text-embedding-3-small y gpt-4o-mini)
# EMBEDDING_MODEL=text-embedding-3-small
# QA_MODEL=gpt-4o-mini

# --- JEV / TypeSafe AI: decisiones rápidas (opcional) ---
# JEV es un modelo de DECISIONES, no genera texto. Clasifica la categoría con
# confianza, puntúa relevancia (0-100) y aplica puertas binarias (duplicado,
# entrega segura). Sin key, todo sigue con heurísticas locales.
# Key: créala en https://console.typesafe.ai (o vía el gateway https://defapi.org)
# y pégala en Render como variable de entorno. NUNCA en código ni en chats.
TYPESAFE_API_KEY=
# JEV_API_KEY=            # alias alternativo a TYPESAFE_API_KEY
# JEV_MODEL=jev-latest    # modelo (default: jev-latest)
# JEV_BASE_URL=https://api.typesafe.ai   # endpoint base (default)

# --- Adaptador Legado Vivo (opcional; sin esto la entrega queda pendiente) ---
# Misma URL y clave del puente actual del Asistente Puente.
LEGADO_VIVO_URL=
BRIDGE_API_KEY=
LEGADO_FAMILY_ID=

# --- v1.4.0: renovación automática del token de Facebook ---
# El token de usuario vive 60 días. Con APP_ID + APP_SECRET, NEXO lo verifica
# solo (/debug_token) y lo renueva (fb_exchange_token) cuando vence dentro del
# margen. Sin estas dos variables, la renovación sigue siendo manual.
# APP_ID y secreto: app "NEXO Personal" en developers.facebook.com →
# Configuración → Información básica. NUNCA en código ni en chats.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Días antes del vencimiento para renovar (default 7)
# FB_TOKEN_REFRESH_MARGIN_DAYS=7

# --- v1.3.0: webhook de WhatsApp multi-mensaje (opt-in) ---
# Sin estas 4 variables el webhook existe pero rechaza los eventos.
# Se configura en una app de Meta APARTE de la del Asistente Puente
# (no se cambia la Callback URL del puente actual).
# Token permanente del número (system user en business.facebook.com)
WHATSAPP_TOKEN=
# ID del número de teléfono de WhatsApp (phone_number_id)
PHONE_NUMBER_ID=
# Token de verificación (lo inventas tú; debe coincidir con Meta)
VERIFY_TOKEN=
# App secret de la app de Meta (para validar la firma de los eventos)
APP_SECRET=
# Loteo multi-mensaje en milisegundos (defaults: 30000 y 180000)
# WA_BATCH_PAUSE_MS=30000   # pausa sin mensajes que cierra el lote
# WA_BATCH_MAX_MS=180000    # tope duro del lote (3 min)
# Autor que aparece en los álbumes preparados para Momentos
MOMENTOS_AUTHOR=Miguel Susffalich
# Si algún día Momentos expone un puente HTTP:
# MOMENTOS_BRIDGE_URL=
