# Copia como .env para desarrollo local. NUNCA subir a git ni pegar valores en chats.
# cp .env.example .env

# Puerto local (Render lo inyecta solo)
PORT=3100

# DRY_RUN=true evita llamadas reales a Graph API (útil para probar sin tokens)
DRY_RUN=false

# Base de datos Neon PostgreSQL (opcional; sin esto usa data.json local)
DATABASE_URL=

# --- Fuentes ---
# Token de usuario de larga duración de Facebook (Graph API Explorer).
# Permisos: user_posts, user_photos (+ instagram_basic para Instagram).
FACEBOOK_USER_TOKEN=

# ID numérico de la cuenta de Instagram (solo si es empresa/creador vinculada a una página de Facebook)
INSTAGRAM_USER_ID=

# --- IA (opcional; sin esto usa heurísticas locales sin costo) ---
OPENAI_API_KEY=

# --- Adaptador Legado Vivo (opcional; sin esto la entrega queda pendiente) ---
# Misma URL y clave del puente actual del Asistente Puente.
LEGADO_VIVO_URL=
BRIDGE_API_KEY=
LEGADO_FAMILY_ID=
